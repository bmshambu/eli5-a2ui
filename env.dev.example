# ── DEV environment config ───────────────────────────────────────────────────
# Copy to .env.dev and fill in. Used when DEPLOYMENT_ENVIRONMENT=dev (the default).

GCP_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STAGING_BUCKET=gs://your-project-adk-staging-dev

# Distinct display name: deploy matches create-or-update by display_name, so reusing
# another agent's name would overwrite it.
AGENT_NAME=eli5-dev
AGENT_DISPLAY_NAME=ELI5 (Dev)
AGENT_DESCRIPTION=Explains any topic as a detailed, KPMG-branded expert briefing with diagrams and sources, plus an ELI5 version on request.

# Set to "probe" to deploy the step 0 iframe probe instead (use the probe names above then).
AGENT_MODE=

# Model for both steps (research with Google Search, then writing). Gemini 2.5 retired on
# Vertex AI on 2026-10-20; use gemini-3.8-flash if gemini-4-argon is not enabled in your project.
MODEL=gemini-4-argon
# Where the model is called. Separate from GOOGLE_CLOUD_LOCATION (the Agent Engine region)
# because the newest models are served from the global endpoint.
MODEL_LOCATION=global
# How hard the model thinks before answering: minimal, low (default, fast), medium, high.
# Leave empty for the model's own default.
THINKING_LEVEL=low
